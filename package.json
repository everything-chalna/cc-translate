{
  "name": "cc-translate",
  "version": "1.0.4",
  "description": "Translate selected text with ChatGPT. Just copy twice.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/render-icons.js && node scripts/make-icon.js",
    "tray-icon": "electron scripts/render-icons.js",
    "dist": "electron-builder --mac --dir --arm64",
    "dmg": "electron-builder --mac dmg --arm64",
    "postinstall": "electron-builder install-app-deps && find node_modules -name '._*' -delete",
    "build:shortcut": "node scripts/build-shortcut.js",
    "prestart": "npm run build:shortcut",
    "predist": "npm run build:shortcut",
    "test": "node --test tests/*.test.js",
    "predmg": "npm run build:shortcut"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.everythingchalna.cctranslate",
    "productName": "CC Translate",
    "files": [
      "*.js",
      "package.json",
      "assets/**",
      "renderer/**",
      "native/selection-shortcut",
      "LICENSE"
    ],
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asar": false
  }
}
